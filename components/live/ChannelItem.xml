<?xml version="1.0" encoding="utf-8" ?>
<!-- One row in the Live TV channel list. Content: ChannelNode. -->
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContent" />
  </interface>

  <children>
    <Label id="num" translation="[20,0]" width="100" height="64" vertAlign="center"
      font="font:SmallSystemFont" color="0x8C96A0FF" />
    <Label id="name" translation="[130,0]" width="780" height="64" vertAlign="center"
      font="font:SmallSystemFont" color="0xE6EAEEFF" />
    <Label id="favorite" translation="[920,0]" width="164" height="64" vertAlign="center" horizAlign="right"
      font="font:SmallestBoldSystemFont" color="0xFFC94DFF" text="FAVORITE" visible="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/live/ChannelItem.brs" />
</component>
