<?xml version="1.0" encoding="utf-8" ?>
<!--
  Full-screen player (an overlay above everything else).

  In:  content       play request from MainScene:
                     { kind: "live" | "movie" | "episode", id, name, url, streamFormat,
                       startPosition, ...metadata echoed back in `progress` }
                     live also: archiveDays (0 = no catch-up archive) and
                       timeshift { url with {start} {duration}, tz: time-zone rule,
                                   lagSeconds: how far behind live the archive is recorded }
       programs      EpgService entry for the live overlay (ignored if not for this channel)
       channelLabel  e.g. "Favorite 3 of 12", shown on the live overlay
       preview       { name, label } the channel Up/Down has reached, shown on the overlay
                     before its stream loads (MainScene loads it once the presses stop)
       errorText     replaces the error message (e.g. after a connection-limit check)
       errorCopies   [{ streamId, name, epgChannelId, archiveDays }] other copies offered on
                     the error panel (OK on one: copyChosen)
       errorCopiesLabel  heading for that list (set first): other copies, or similar channels
       channelInfo   channel info for the side panel (MainChannelInfo.brs); live stream
                     details are added here while it's open
  Out: progress      { play, position, duration, finished } every 30 s and on stop (not live)
       failed        { play, code, message } when the Video node errors, or code -100
                     when a live channel keeps stalling after 4 reloads, -101 when its
                     stream ends twice within 2 minutes
       channelStep   +1 / -1 when Up / Down is pressed during live playback
       toggleFavorite { streamId, name, epgChannelId } when * is pressed during live playback
       liveViewed    { streamId, name, epgChannelId } after a minute of a live channel playing
       livePlaying   { streamId } when a live channel first starts playing
       liveWatched   same, after channelViewSeconds playing (usage scores; surfing doesn't count)
       infoRequested { streamId, name, epgChannelId } when OK is pressed with the live
                     overlay already up (opens the channel info panel)
       copyChosen    a copy picked from the info panel's Other copies or the error panel
       closed        true when the user leaves the player

  Live modes: "live" -> Play/Pause pauses ("paused") -> Play continues from the
  pause point: from the player's own buffer after a short pause, otherwise via
  the provider's timeshift stream ("timeshift"). Rewind from live jumps into
  the archive as close to live as it has recorded. In timeshift the Video
  node's own controls work; Back returns to live. An archive stretch that ends
  while more has been recorded loads the next stretch; one that never plays
  shows a note and rejoins live.
-->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="content" type="assocarray" onChange="onContent" />
    <field id="programs" type="assocarray" onChange="onPrograms" alwaysNotify="true" />
    <field id="channelLabel" type="string" onChange="onChannelLabel" />
    <field id="preview" type="assocarray" onChange="onPreview" />
    <field id="toggleFavorite" type="assocarray" alwaysNotify="true" />
    <field id="errorText" type="string" onChange="onErrorText" alwaysNotify="true" />
    <field id="progress" type="assocarray" alwaysNotify="true" />
    <field id="failed" type="assocarray" alwaysNotify="true" />
    <field id="channelStep" type="integer" alwaysNotify="true" />
    <field id="liveViewed" type="assocarray" alwaysNotify="true" />
    <field id="livePlaying" type="assocarray" alwaysNotify="true" />
    <field id="channelViewSeconds" type="integer" value="180" />
    <field id="liveWatched" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <field id="channelInfo" type="assocarray" onChange="onChannelInfo" />
    <field id="infoRequested" type="assocarray" alwaysNotify="true" />
    <field id="copyChosen" type="assocarray" alwaysNotify="true" />
    <field id="errorCopiesLabel" type="string" />
    <field id="errorCopies" type="array" onChange="onErrorCopies" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" />

    <Group id="liveOverlay" visible="false">
      <Poster translation="[0,640]" width="1920" height="440" uri="pkg:/images/ui/fade-bottom.png" />
      <Label id="modeLine" translation="[96,676]" width="1728" font="font:SmallBoldSystemFont" color="0xFFC94DFF" />
      <Label id="channelName" translation="[96,716]" width="1300" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="channelPos" translation="[1424,728]" width="400" horizAlign="right"
        font="font:SmallSystemFont" color="0x8C96A0FF" />
      <Label id="nowTitle" translation="[96,790]" width="1300" font="font:MediumSystemFont" color="0xE6EAEEFF" />
      <!-- The current program's description (episode synopsis), when the guide has one. -->
      <Label id="nowDesc" translation="[96,846]" width="1728" height="80" wrap="true" maxLines="2"
        font="font:SmallestSystemFont" color="0xA0A8B0FF" />
      <Label id="nowTime" translation="[1424,796]" width="400" horizAlign="right"
        font="font:SmallSystemFont" color="0x8C96A0FF" />
      <Rectangle id="progressTrack" translation="[96,936]" width="1728" height="6" color="0x3A444EFF" />
      <!-- Up to live: shown lighter past the blue fill when watching behind live. -->
      <Rectangle id="progressLive" translation="[96,936]" width="0" height="6" color="0x8A96A3FF" />
      <Rectangle id="progressFill" translation="[96,936]" width="0" height="6" color="0x4DA3FFFF" />
      <Label id="nextLine" translation="[96,962]" width="1728" font="font:SmallSystemFont" color="0x8C96A0FF" />
      <Label id="hints" translation="[96,1016]" width="1728" font="font:SmallestSystemFont" color="0x6E7882FF" />
    </Group>

    <Group id="errorPanel" visible="false">
      <Poster id="errorBg" translation="[360,330]" width="1200" height="420" uri="pkg:/images/ui/rounded.9.png" blendColor="0x1F2833F2" />
      <Label translation="[420,380]" width="1080" font="font:LargeBoldSystemFont" color="0xFFFFFFFF"
        text="Can't play this" />
      <Label id="errorMessage" translation="[420,460]" width="1080" height="200" wrap="true"
        font="font:MediumSystemFont" color="0xD0D6DCFF" />
      <!-- A live channel's other copies (same guide ID), when it has any:
           often encoded differently, so one may play where this didn't. -->
      <Label id="copiesHead" translation="[420,670]" width="1080" font="font:SmallBoldSystemFont" color="0x4DA3FFFF"
        visible="false" text="Try another copy of this channel   (OK to play)" />
      <LabelList id="errorCopies" translation="[420,712]" itemSize="[1080,48]" numRows="4" visible="false"
        font="font:SmallSystemFont" focusedFont="font:SmallBoldSystemFont"
        color="0xB8C1CAFF" focusedColor="0xFFFFFFFF" focusBitmapUri="pkg:/images/ui/row-focus.9.png"
        vertFocusAnimationStyle="floatingFocus" />
      <Label id="errorBack" translation="[420,680]" width="1080" font="font:SmallSystemFont" color="0x8C96A0FF"
        text="Press Back to return." />
    </Group>

    <!-- Channel info (OK twice while watching live); Back closes it. -->
    <ChannelInfoPanel id="infoPanel" visible="false" />
    <Timer id="statsTimer" duration="2" repeat="true" />

    <Timer id="overlayTimer" duration="5" />
    <!-- An archive stream that never starts playing counts as failed. Generous:
         the provider's archive segments are a full minute each. -->
    <Timer id="timeshiftTimeout" duration="30" />
    <Timer id="saveTimer" duration="30" repeat="true" />
    <!-- Counts seconds of live video actually playing (not paused, buffering
         or failed): viewed after a minute, watched after channelViewSeconds. -->
    <Timer id="liveTick" duration="5" repeat="true" />
    <!-- Stall watchdog: a stream that has played and then sits in
         "buffering" this long is reloaded (live 6 s, at the live point;
         movies, episodes and the archive 25 s, where it was; watchStall). -->
    <Timer id="stallTimer" duration="6" />
    <!-- A live channel, movie or episode with no video this long after
         loading, and no error either, counts as failed (onStartTimeout). -->
    <Timer id="startTimer" duration="25" />
    <!-- Live buffer: jumps (Rewind, Left ...) pressed in a row add up and
         happen once this long after the last (bufferKey). -->
    <Timer id="seekTimer" duration="0.5" />
    <!-- A jump key held down: another step this often until it's let go
         (shorter than seekTimer, so the jump waits for the release). -->
    <Timer id="holdTimer" duration="0.4" repeat="true" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/player/PlayerScreen.brs" />
</component>
