<?xml version="1.0" encoding="utf-8" ?>
<!--
  Settings. In: info { deviceName, deviceId, server, version, connections, market,
  showMyTeams, myTeamsFirst, showNoGameTeams, showFavoritesInRecent }.
  Out: chosen ("teams" opens My Teams, "teamsRow" toggles the My Teams row,
  "teamsPosition" switches it between after Favorites and first,
  "noGameTeams" toggles cards for teams with no game,
  "market" opens Local stations, "recentFavorites" toggles favorites in
  Recently Viewed, "account" opens Setup).
-->
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="info" type="assocarray" onChange="onInfo" />
    <field id="chosen" type="string" alwaysNotify="true" />
  </interface>

  <children>
    <LabelList id="menu" translation="[96,190]" itemSize="[800,64]"
      font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont"
      color="0xB8C1CAFF" focusedColor="0xFFFFFFFF" focusBitmapUri="pkg:/images/ui/row-focus.9.png"
      vertFocusAnimationStyle="floatingFocus" />
    <Label id="details" translation="[96,680]" width="1600" wrap="true"
      font="font:SmallSystemFont" color="0x8C96A0FF" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
</component>
