<?xml version="1.0" encoding="utf-8" ?>
<!--
  Search index for live channels, movies and series. Runs on its own thread:
  the full lists (~11,000 channels) are read from cachefs: files written by
  ApiTask (saveOnly), indexed here, and only matches cross to the render
  thread.

  As with ApiTask, wait for `ready` before setting `load` or `query`.

  In:  load     { kind: "live" | "movie" | "series", file }   (re)index one kind from a cache file
                { kind: "categories" }  the live category list (cachefs:/catalog/live_categories.json)
                changed: My Teams and local stations re-read it
                { kind: "reset" }  empty every index (account changed)
       query    { id, text, market }   newest wins; older pending queries are skipped
  Out: results  { id, text, items: [ { kind: "channel" | "movie" | "series", itemId, streamId,
                  name, num, epgChannelId, ext, year, archiveDays, local } ] }
                grouped channels (the market's local stations first, local: true),
                then movies, then series; each capped
       archive  { "<streamId>": archiveDays } for live channels with a catch-up archive
       counts   { live, movie, series } items indexed per kind
       indexVersion  bumped after every (re)index, so saved items can be re-matched

  Channel matching (ChannelMatch.brs):
  In:  matchRequest { id, channels: [{ streamId, name, epgChannelId }], series: [{ seriesId, name, year }] }
  Out: matchResult  { id, liveReady, seriesReady,
                      channels: { "<old streamId>": { streamId, name, epgChannelId, method } },
                      series: { "<old seriesId>": { seriesId, name, year, method } }, unmatched: [text] }
       Only items whose IDs are missing from the loaded catalog are matched.
  selfTest: set true to run the matching self-test once both lists are loaded.

  My Teams (MyTeams.brs):
  In:  gamesRequest { id, teams: [{ id, name, aliases[], exclusions[], sports[] }], withGuide, market }
       market: "GA|Atlanta" adds that market's local stations to the networks.
  In:  scoresRequest { id, files: [cachefs: ESPN scoreboards], games: [{ key, names[], start }] }
  Out: scoresResult  { id, scores: { "<game key>": "LAD 3 - ATL 1   Top 8th" } } (findScores)
  Out: gamesResult  { id, ready, games: [{ key, teamId, teamName, title, sport, sportLabel,
                      start, ends, live, replay, channels: [{ streamId, name, epgChannelId, network }] }],
                      networks: [{ label, streamId, name, epgChannelId, guideFile }] }
       withGuide also searches the network channels' short guides, read from
       their guideFile (saved to cachefs: by ApiTask for MainScene).
  In:  localsRequest { id, market }
  Out: localsResult  { id, market, ready, items: [get_live_streams-shaped items] } (ABC, CBS, NBC, FOX)
  In:  guideRequest  { id, categoryId }   the Guide: live categories, and one category's channels
  Out: guideResult   { id, categoryId, ready, categories: [{ id, name }],
                       channels: [{ streamId, name, epgChannelId, archiveDays, logo }] }
  In:  iconsRequest  { id, streamIds: [] }   logos for Home channel cards
  Out: iconsResult   { id, ready, icons: { "<streamId>": url or "" } }
  In:  infoRequest   { id, streamId, market, similar }   channel info (similar: also find
                     channels with similar names when there are no copies)
  Out: infoResult    { id, streamId, found, name, icon, epgChannelId, archiveDays, category, local,
                       copies: [{ streamId, name, epgChannelId, archiveDays }], similar: [same] }
                     (copies: same guide ID; similar: names sharing the main words; up to 15 each)
  In:  marketsRequest { id }
  Out: marketsResult  { id, ready, markets: [{ key: "GA|Atlanta", label: "Atlanta, GA", stations: "ABC, CBS, NBC, FOX" }] }
-->
<component name="SearchTask" extends="Task">
  <interface>
    <field id="ready" type="boolean" value="false" />
    <field id="load" type="assocarray" alwaysNotify="true" />
    <field id="query" type="assocarray" alwaysNotify="true" />
    <field id="results" type="assocarray" alwaysNotify="true" />
    <field id="archive" type="assocarray" />
    <field id="counts" type="assocarray" />
    <field id="indexVersion" type="integer" alwaysNotify="true" />
    <field id="indexFailed" type="string" alwaysNotify="true" />
    <field id="matchRequest" type="assocarray" alwaysNotify="true" />
    <field id="matchResult" type="assocarray" alwaysNotify="true" />
    <field id="selfTest" type="boolean" value="false" />
    <field id="gamesRequest" type="assocarray" alwaysNotify="true" />
    <field id="gamesResult" type="assocarray" alwaysNotify="true" />
    <field id="scoresRequest" type="assocarray" alwaysNotify="true" />
    <field id="scoresResult" type="assocarray" alwaysNotify="true" />
    <field id="marketsRequest" type="assocarray" alwaysNotify="true" />
    <field id="marketsResult" type="assocarray" alwaysNotify="true" />
    <field id="localsRequest" type="assocarray" alwaysNotify="true" />
    <field id="localsResult" type="assocarray" alwaysNotify="true" />
    <field id="guideRequest" type="assocarray" alwaysNotify="true" />
    <field id="guideResult" type="assocarray" alwaysNotify="true" />
    <field id="iconsRequest" type="assocarray" alwaysNotify="true" />
    <field id="iconsResult" type="assocarray" alwaysNotify="true" />
    <field id="infoRequest" type="assocarray" alwaysNotify="true" />
    <field id="infoResult" type="assocarray" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/services/ChannelMatch.brs" />
  <script type="text/brightscript" uri="pkg:/components/services/MyTeams.brs" />
  <script type="text/brightscript" uri="pkg:/components/services/SearchTask.brs" />
</component>
