<?xml version="1.0" encoding="utf-8" ?>
<!--
  The only path to saved state. Callers use these functions via callFunc and
  never touch the registry. The storage backend (registry in version 1) sits
  behind read()/write() so a remote backend can be added later.

  Every mutating function saves immediately and returns true only if the
  write reached the registry. A failed write undoes the change, so the state
  callers read back is always what's saved.
-->
<component name="StateStore" extends="Node">
  <interface>
    <function name="isConfigured" />
    <function name="getCredentials" />
    <function name="setAccount" />
    <function name="getDevice" />
    <function name="getMarket" />
    <function name="setMarket" />
    <function name="getSettings" />
    <function name="setSetting" />

    <function name="getFavorites" />
    <function name="isFavorite" />
    <function name="addFavorite" />
    <function name="removeFavorite" />

    <function name="getRecent" />
    <function name="addRecent" />

    <function name="getResume" />
    <function name="getPosition" />
    <function name="savePosition" />
    <function name="clearPosition" />

    <function name="markWatched" />
    <function name="markUnwatched" />
    <function name="removeFromContinue" />
    <function name="getSeriesProgress" />
    <function name="getSeriesList" />

    <function name="getTeams" />
    <function name="saveTeam" />
    <function name="deleteTeam" />
    <function name="setTeamLogo" />
    <function name="getSeenGames" />
    <function name="recordSeenGames" />

    <function name="recordUsage" />
    <function name="getUsageScores" />
    <function name="getChannelViewSeconds" />
    <function name="setPinned" />

    <function name="remapChannels" />
    <function name="remapSeries" />
    <function name="remapEpisodes" />
    <function name="getSavedSeries" />
    <function name="exportDocument" />
    <function name="setSeriesFavorite" />
    <function name="isSeriesFavorite" />
    <function name="getFavoriteSeries" />

    <function name="getWatchList" />
    <function name="isOnWatchList" />
    <function name="watchListFull" />
    <function name="setOnWatchList" />
    <function name="updateWatchListDetails" />
    <function name="getSavedMovies" />
    <function name="remapMovies" />

    <function name="getRecentSearches" />
    <function name="addRecentSearch" />
    <function name="removeRecentSearch" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/services/RegistryBackend.brs" />
  <script type="text/brightscript" uri="pkg:/components/services/StateStore.brs" />
</component>
