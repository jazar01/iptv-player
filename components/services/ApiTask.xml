<?xml version="1.0" encoding="utf-8" ?>
<!--
  Every HTTP call goes through this task: roUrlTransfer can't run on the render
  thread, and retries, caching and error handling live in one place.

  Set `credentials` once, then set `request`. Up to 4 requests run at once, so
  responses can arrive in any order; match them by `id`.

  The task thread starts after control = "RUN"; a request set before it is
  listening is silently lost. Don't send until `ready` is true.

  request:  { id, action, params?, context?, timeoutMs?, cacheFile?, cacheFirst?,
              maxAgeSeconds?, saveOnly?, priority? }
  priority "low" marks background work (full catalogs, network schedules,
  logos): it starts only after waiting on-screen requests, and at most two
  run at once, so a slot is always free for what the viewer is doing.
                Xtream player_api.php call
            { id, url, ... }      plain GET returning JSON
            { id, op: "clearCache" }
  response: { id, action, context, ok, code, error, data, fromCache, unchanged, ms }

  cacheFile (a cachefs: path) saves each successful body. With cacheFirst, a
  cached copy is answered immediately (fromCache=true), then the fresh copy;
  if the fresh body is identical the second response has unchanged=true and
  no data.

  maxAgeSeconds answers from cacheFile without the network if it was written
  less than that long ago. saveOnly writes the body to cacheFile and answers
  without data (for big lists that another Task reads from disk).
-->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="ready" type="boolean" value="false" />
    <field id="credentials" type="assocarray" />
    <field id="request" type="assocarray" alwaysNotify="true" />
    <field id="response" type="assocarray" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/services/ApiTask.brs" />
</component>
