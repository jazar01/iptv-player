<?xml version="1.0" encoding="utf-8" ?>
<!--
  Content for one CatalogItem. itemId is the stream ID (live, movie) or series
  ID. num is the year for movies (empty for channels and series, which
  carry the year in the name).
  tag is shown at the right, e.g. FAVORITE or IN PROGRESS.
-->
<component name="CatalogNode" extends="ContentNode">
  <interface>
    <field id="itemId" type="integer" />
    <field id="num" type="string" />
    <field id="name" type="string" />
    <field id="epgChannelId" type="string" />
    <field id="ext" type="string" />
    <field id="year" type="integer" />
    <field id="tag" type="string" />
    <field id="archiveDays" type="integer" />
    <!-- Search results mix kinds: "channel" | "movie" | "series". -->
    <field id="itemKind" type="string" />
    <!-- Search results: one of the device's local stations (Settings -> Local stations). -->
    <field id="isLocal" type="boolean" />
    <!-- Channel rows: a logo column (logo "" leaves it empty, names stay aligned). -->
    <field id="showLogo" type="boolean" />
    <field id="logo" type="string" />
  </interface>
</component>
