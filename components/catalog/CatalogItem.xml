<?xml version="1.0" encoding="utf-8" ?>
<!-- One row in a catalog list (channels, movies, series). Content: CatalogNode. -->
<component name="CatalogItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContent" />
    <!-- Set by the MarkupList: drawn dark on the white focus bar. -->
    <field id="focusPercent" type="float" onChange="applyColors" />
    <field id="listHasFocus" type="boolean" onChange="applyColors" />
  </interface>

  <children>
    <!-- Channel rows: the logo column. -->
    <Poster id="logo" translation="[16,8]" width="80" height="48" loadDisplayMode="scaleToFit" visible="false" />
    <Label id="num" translation="[20,0]" width="100" height="64" vertAlign="center"
      font="font:SmallSystemFont" color="0x8C96A0FF" />
    <Label id="name" translation="[130,0]" width="760" height="64" vertAlign="center"
      font="font:SmallSystemFont" color="0xE6EAEEFF" />
    <Label id="tag" translation="[900,0]" width="184" height="64" vertAlign="center" horizAlign="right"
      font="font:SmallestBoldSystemFont" color="0xFFC94DFF" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/catalog/CatalogItem.brs" />
</component>
