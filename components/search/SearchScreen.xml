<?xml version="1.0" encoding="utf-8" ?>
<!--
  Search: a mini keyboard on the left, results on the right (channels, then
  movies, then series). Results update after a short pause in typing.

  In:  results    SearchTask results { text, items }
       favoriteIds { "<streamId>": true, "s<seriesId>": true }, to tag favorite channels and series
       status     message shown where the results go
       recentSearches  [text] newest first, listed while the box is empty
       reset      set when Search is opened from the top bar: empty box, recent searches
  Out: query      search text (after the typing pause)
       selected   { kind, itemId, streamId, name, epgChannelId, ext, year, archiveDays }
       options    same, when * is pressed on a channel
       searchUsed      the search text, when one of its results is chosen
       removeRecent    a recent search to forget (* on it)
-->
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="results" type="assocarray" onChange="onResults" />
    <field id="favoriteIds" type="assocarray" onChange="onFavoriteIds" />
    <!-- alwaysNotify: setting "" must hide the initial hint even though the
         field already holds "". -->
    <field id="status" type="string" onChange="onStatus" alwaysNotify="true" />
    <field id="query" type="string" alwaysNotify="true" />
    <field id="selected" type="assocarray" alwaysNotify="true" />
    <field id="options" type="assocarray" alwaysNotify="true" />
    <field id="recentSearches" type="array" onChange="onRecentSearches" />
    <field id="searchUsed" type="string" alwaysNotify="true" />
    <field id="removeRecent" type="string" alwaysNotify="true" />
    <field id="reset" type="boolean" alwaysNotify="true" onChange="onReset" />
  </interface>

  <children>
    <!-- DynamicMiniKeyboard: MiniKeyboard plus voice entry (set to whole words). -->
    <DynamicMiniKeyboard id="keyboard" translation="[96,190]" />
    <MarkupList id="resultList" translation="[720,256]" itemComponentName="CatalogItem"
      itemSize="[1104,64]" itemSpacing="[0,4]" numRows="11" vertFocusAnimationStyle="floatingFocus"
      focusBitmapUri="pkg:/images/ui/row-focus.9.png" />
    <!-- Over the list while it shows recent searches. The list starts below
         y 200, clear of Roku's own "use your phone" keyboard banner. -->
    <Label id="recentHead" translation="[740,206]" width="1080" visible="false"
      font="font:SmallSystemFont" color="0xA0A8B0FF" text="Recent searches      OK to search again     *  to remove" />
    <Label id="status" translation="[740,270]" width="1080" wrap="true"
      font="font:MediumSystemFont" color="0xA0A8B0FF" text="Type to search channels, movies and series." />
    <Timer id="typingDelay" duration="0.35" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/search/SearchScreen.brs" />
</component>
