<?xml version="1.0" encoding="utf-8" ?>
<!--
  One series: seasons on the left, episodes on the right, each marked
  watched, in progress or new. * on an episode marks it watched or unwatched;
  * on the seasons adds the series to (or removes it from) Favorite Series.

  In:  info      { seriesId, name, year, seasons: [{ season, episodes: [{ id, season, episode, name, ext, duration }] }] }
       progress  StateStore getSeriesProgress() result
       focusEpisodeId  episode to focus when info arrives (the series' current one)
       isFavorite  whether the series is in Favorite Series (shown in the title)
       status    message while loading or on error
       media     { id, text } what's in an episode's file, from the Pi (shown with its details)
  Out: selected  episode summary (see episodeSummary)
       mediaWanted  { id, ext } for the episode focused a moment (its media isn't known yet)
       options   same, when * is pressed on an episode
       favoriteToggle  { itemId, name, year } when * is pressed on the seasons
-->
<component name="SeriesScreen" extends="Group">
  <interface>
    <field id="info" type="assocarray" onChange="onInfo" />
    <field id="progress" type="assocarray" onChange="onProgress" />
    <field id="focusEpisodeId" type="integer" />
    <!-- alwaysNotify: setting "" must hide the initial "Loading" text even
         though the field already holds "". -->
    <field id="status" type="string" onChange="onStatus" alwaysNotify="true" />
    <field id="media" type="assocarray" onChange="onMedia" />
    <field id="mediaWanted" type="assocarray" alwaysNotify="true" />
    <field id="selected" type="assocarray" alwaysNotify="true" />
    <field id="options" type="assocarray" alwaysNotify="true" />
    <field id="isFavorite" type="boolean" onChange="drawTitle" />
    <field id="favoriteToggle" type="assocarray" alwaysNotify="true" />
  </interface>

  <children>
    <Poster width="1920" height="1080" uri="pkg:/images/ui/background.jpg" />
    <!-- The series backdrop, darkened so the text and lists stay readable. -->
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="zoomToFill" visible="false" />
    <Rectangle width="1920" height="1080" color="0x0B1016C8" />

    <!-- Header: cover, title, year / genre / rating, plot. -->
    <Poster id="cover" translation="[96,40]" width="200" height="300" loadDisplayMode="scaleToFit" />
    <Label id="title" translation="[330,40]" width="1490" wrap="true" maxLines="1"
      font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
    <Label id="meta" translation="[330,108]" width="1490" font="font:SmallSystemFont" color="0xC8D0D8FF" />
    <Label id="plot" translation="[330,152]" width="1490" wrap="true" maxLines="4" lineSpacing="2"
      font="font:SmallSystemFont" color="0xE6EAEEFF" />
    <Label id="people" translation="[330,300]" width="1490" maxLines="1"
      font="font:SmallestSystemFont" color="0x8C96A0FF" />

    <LabelList id="seasonList" translation="[96,370]" itemSize="[300,60]" numRows="9"
      font="font:SmallSystemFont" focusedFont="font:SmallBoldSystemFont"
      color="0xB8C1CAFF" focusedColor="0xFFFFFFFF" vertFocusAnimationStyle="floatingFocus"
      focusBitmapUri="pkg:/images/ui/row-focus.9.png" />
    <MarkupList id="episodeList" translation="[440,370]" itemComponentName="EpisodeItem"
      itemSize="[1384,72]" itemSpacing="[0,4]" numRows="6" vertFocusAnimationStyle="floatingFocus"
      focusBitmapUri="pkg:/images/ui/row-focus.9.png" />

    <!-- The focused episode: air date, length and description (when sent). -->
    <Label id="epPlot" translation="[460,840]" width="1364" height="140" wrap="true" maxLines="4" lineSpacing="2"
      font="font:SmallestSystemFont" color="0xC8D0D8FF" />
    <Label translation="[96,1030]" width="1728" font="font:SmallestSystemFont" color="0x6E7882FF"
      text="* on an episode: mark it watched or unwatched.     * on the seasons: add to or remove from Favorite Series." />

    <!-- Asks for the focused episode's media once focus rests there. -->
    <Timer id="mediaTimer" duration="0.8" />
    <Label id="status" translation="[460,390]" width="1360" wrap="true"
      font="font:MediumSystemFont" color="0xA0A8B0FF" text="Loading episodes ..." />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/series/SeriesScreen.brs" />
</component>
