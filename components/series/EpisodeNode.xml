<?xml version="1.0" encoding="utf-8" ?>
<!-- Content for one EpisodeItem. state: "watched" | "progress" | "new". -->
<component name="EpisodeNode" extends="ContentNode">
  <interface>
    <field id="episodeId" type="integer" />
    <field id="season" type="integer" />
    <field id="episode" type="integer" />
    <field id="name" type="string" />
    <!-- name without the repeated series name and S01E01 code, for the list -->
    <field id="displayName" type="string" />
    <field id="ext" type="string" />
    <field id="duration" type="integer" />
    <field id="state" type="string" />
    <field id="stateText" type="string" />
    <!-- Shown below the list: the episode's description and air date. -->
    <field id="plot" type="string" />
    <field id="airDate" type="string" />
  </interface>
</component>
