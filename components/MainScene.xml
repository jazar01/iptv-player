<?xml version="1.0" encoding="utf-8" ?>
<!--
  Owns the screens and the services. Screens talk only to MainScene; only the
  services touch the network (ApiTask, EpgService via ApiTask) or saved state
  (StateStore).

  Layers, bottom to top: section screens (Home, Live TV, Movies, Series,
  Settings), top bar, overlays (Setup, "See all" grids, series pages, player),
  toast. Dialogs (resume prompt, keyboards) use the Scene's `dialog` field.
-->
<component name="MainScene" extends="Scene">
  <interface>
    <!-- Set after "Exit IPTV Player?" is confirmed; main.brs then ends the app. -->
    <field id="exitApp" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Poster id="background" width="1920" height="1080" uri="pkg:/images/ui/background.jpg" />
    <Group id="screenHost" />
    <TopBar id="topBar" visible="false" />
    <Group id="overlayHost" />

    <Group id="toast" visible="false">
      <Poster translation="[460,950]" width="1000" height="72" uri="pkg:/images/ui/rounded.9.png" blendColor="0x2E3946FF" />
      <Label id="toastText" translation="[480,950]" width="960" height="72"
        horizAlign="center" vertAlign="center" font="font:SmallSystemFont" color="0xFFFFFFFF" />
    </Group>
    <Timer id="toastTimer" duration="3" />
    <!-- Re-asks EpgService for on-screen channels; it only refetches entries
         whose current program has ended. -->
    <Timer id="epgTimer" duration="60" repeat="true" />

    <StateStore id="stateStore" />
    <EpgService id="epg" />
    <ApiTask id="api" />
    <SearchTask id="searchTask" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/home/CardContent.brs" />
  <script type="text/brightscript" uri="pkg:/components/home/HomeRows.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainLogin.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainHome.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainCatalog.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainPlayback.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainSearch.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainTeams.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainChannelInfo.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainMovies.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainGuide.brs" />
</component>
