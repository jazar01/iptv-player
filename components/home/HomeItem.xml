<?xml version="1.0" encoding="utf-8" ?>
<!--
  Content for one HomeCard. kind: "channel" | "resume" | "seeAll" | "empty".
  Program fields are UTC seconds; epgVersion is bumped whenever they change so
  the card redraws in place.
-->
<component name="HomeItem" extends="ContentNode">
  <interface>
    <field id="kind" type="string" />
    <field id="rowId" type="string" />
    <field id="itemKey" type="string" />
    <field id="streamId" type="integer" />
    <field id="name" type="string" />
    <field id="epgChannelId" type="string" />
    <field id="nowTitle" type="string" />
    <field id="nowFlags" type="string" />
    <field id="nowStart" type="integer" />
    <field id="nowEnd" type="integer" />
    <field id="nextTitle" type="string" />
    <field id="nextStart" type="integer" />
    <field id="position" type="integer" />
    <field id="duration" type="integer" />
    <field id="message" type="string" />
    <field id="epgVersion" type="integer" />
  </interface>
</component>
