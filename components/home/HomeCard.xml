<?xml version="1.0" encoding="utf-8" ?>
<!-- One 400x220 card in a home row or a "See all" grid. Content: HomeItem. -->
<component name="HomeCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContent" />
  </interface>

  <children>
    <Poster id="bg" width="400" height="220" uri="pkg:/images/ui/rounded.9.png" blendColor="0x1F2833FF" />

    <Group id="channel">
      <Label id="name" translation="[20,14]" width="360" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="nowTitle" translation="[20,58]" width="360" height="72" wrap="true" maxLines="2"
        font="font:SmallSystemFont" color="0xD0D6DCFF" />
      <Label id="tags" translation="[20,128]" width="360" font="font:SmallestBoldSystemFont" color="0xFF7A6BFF" />
      <Rectangle id="progressTrack" translation="[20,160]" width="360" height="6" color="0x3A444EFF" />
      <Rectangle id="progressFill" translation="[20,160]" width="0" height="6" color="0x4DA3FFFF" />
      <Label id="nextLine" translation="[20,176]" width="360" font="font:SmallestSystemFont" color="0x8C96A0FF" />
    </Group>

    <Group id="info" visible="false">
      <Label id="infoTitle" translation="[20,14]" width="360" wrap="true" maxLines="2"
        font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="infoText" translation="[20,108]" width="360" wrap="true" maxLines="2"
        font="font:SmallSystemFont" color="0xA0A8B0FF" />
      <Rectangle id="infoTrack" translation="[20,184]" width="360" height="6" color="0x3A444EFF" />
      <Rectangle id="infoFill" translation="[20,184]" width="0" height="6" color="0x4DA3FFFF" />
    </Group>

    <!-- My Teams: the team's logo (placed by drawBadge), or its initials while
         there's no logo (none found, still loading, or failed to load). -->
    <Group id="badge" translation="[306,128]" visible="false">
      <Poster width="78" height="78" uri="pkg:/images/ui/rounded.9.png" blendColor="0x2C3742FF" />
      <Label id="initials" width="78" height="78" horizAlign="center" vertAlign="center"
        font="font:MediumBoldSystemFont" color="0xC8D0D8FF" />
      <Poster id="logo" translation="[7,7]" width="64" height="64" loadDisplayMode="scaleToFit" />
    </Group>

    <!-- Keeps the progress bar moving while the card is on screen. -->
    <Timer id="tick" duration="30" repeat="true" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/home/HomeCard.brs" />
</component>
